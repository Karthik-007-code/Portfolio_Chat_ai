# =============================================================================
# Ask Karthik – Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider (Groq)
# Get your free API key at: https://console.groq.com
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------------------
# Model configuration
# Available on this Groq key: qwen/qwen3.8-27b | openai/gpt-oss-120b | allam-2-7b
# Standard Groq key models: llama-3.3-70b-versatile | llama3-8b-8192 | mixtral-8x7b-32768
# -----------------------------------------------------------------------------
LLM_MODEL=qwen/qwen3.8-27b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Security – allowed frontend origins (comma-separated)
# Add your production domain once deployed to Render.
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=https://karthik-007-code.github.io,http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Conversation limits
# -----------------------------------------------------------------------------
MAX_MESSAGE_LENGTH=1000
MAX_CONVERSATION_TURNS=20
MAX_MESSAGES_PER_MINUTE=15

